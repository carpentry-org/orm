(load "Test.carp")
(load "../backends/sqlite3.carp")

(use Test)

(deftype Todo [id Int
               text String
               done Bool])
(derive-model Todo SQLiteBackend [id Int])

(deftype Note [id Long
               title String
               body String
               score Double
               pinned Bool])
(derive-model Note SQLiteBackend [id Long])

; Composite PK model: a many-to-many join table
(deftype Enrollment [sid Int
                     cid Int
                     grade String])
(derive-model Enrollment SQLiteBackend [sid Int cid Int])

; Open a fresh in-memory DB and run the Todo table migration.
(defn fresh-db []
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Todo.create-table &db))
    db))

(defn insert-todo [db text done]
  (Result.unsafe-from-success (Todo.insert db &(Todo.init 0 text done))))

(deftest test
  ;; find-all returns empty after create-table
  (let-do [db (fresh-db)
           n (Array.length &(Result.unsafe-from-success (Todo.find-all &db)))]
    (SQLite3.close db)
    (assert-equal test 0 n "find-all returns 0 rows after create-table"))

  ;; insert returns sequential rowids
  (let-do [db (fresh-db)
           id1 (insert-todo &db @"buy milk" false)
           id2 (insert-todo &db @"write carp" true)]
    (SQLite3.close db)
    (ignore (assert-equal test 1 id1 "insert returns rowid 1 for first row"))
    (assert-equal test 2 id2 "insert returns rowid 2 for second row"))

  ;; find-by-id round-trips all fields
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (let-do [t (Result.unsafe-from-success (Todo.find-by-id &db &1))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          @(Todo.id &t)
          "find-by-id returns row with matching id"))
      (ignore
        (assert-equal test
          "buy milk"
          (Todo.text &t)
          "find-by-id returns row with stored text"))
      (assert-equal test
        false
        @(Todo.done &t)
        "find-by-id returns row with stored done flag")))

  ;; update writes data fields
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (ignore (Todo.update &db &(Todo.init 1 @"done task" true)))
    (let-do [t (Result.unsafe-from-success (Todo.find-by-id &db &1))]
      (SQLite3.close db)
      (ignore
        (assert-equal test "done task" (Todo.text &t) "update writes new text"))
      (assert-equal test true @(Todo.done &t) "update writes new done flag")))

  ;; delete-by-id removes only the matching row
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"keep" false))
    (ignore (insert-todo &db @"remove" false))
    (ignore (Todo.delete-by-id &db &2))
    (let-do [remaining (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          (Array.length &remaining)
          "delete-by-id removes exactly one row"))
      (assert-equal test
        "keep"
        (Todo.text (Array.unsafe-nth &remaining 0))
        "remaining row is the one that wasn't deleted")))

  ;; find-where filters by condition
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (let-do [done-items (Result.unsafe-from-success
               (Todo.find-where &db "done = ?1" &[(to-sqlite3 1)]))]
      (SQLite3.close db)
      (assert-equal test
        1
        (Array.length &done-items)
        "find-where returns only matching rows")))

  ;; find-where with multiple conditions
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (let-do [items (Result.unsafe-from-success
               (Todo.find-where &db
                                "done = ?1 AND text = ?2"
                                &[(to-sqlite3 0) (to-sqlite3 @"buy milk")]))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          (Array.length &items)
          "find-where with multiple conditions"))
      (assert-equal test
        "buy milk"
        (Todo.text (Array.unsafe-nth &items 0))
        "find-where returns correct row")))

  ;; find-where returns empty when no match
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [items (Result.unsafe-from-success
               (Todo.find-where &db "text = ?1" &[(to-sqlite3 @"nonexistent")]))]
      (SQLite3.close db)
      (assert-equal test
        0
        (Array.length &items)
        "find-where returns empty array when no match")))

  ;; count returns 0 on empty table
  (let-do [db (fresh-db)
           n (Result.unsafe-from-success (Todo.count &db))]
    (SQLite3.close db)
    (assert-equal test 0 n "count returns 0 on empty table"))

  ;; count returns correct number after inserts
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (let-do [n (Result.unsafe-from-success (Todo.count &db))]
      (SQLite3.close db)
      (assert-equal test 3 n "count returns 3 after three inserts")))

  ;; count-where returns matching count
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (let-do [n (Result.unsafe-from-success
               (Todo.count-where &db "done = ?1" &[(to-sqlite3 0)]))]
      (SQLite3.close db)
      (assert-equal test 2 n "count-where returns 2 for done=false")))

  ;; count-where returns 0 when no match
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [n (Result.unsafe-from-success
               (Todo.count-where &db "text = ?1" &[(to-sqlite3 @"nonexistent")]))]
      (SQLite3.close db)
      (assert-equal test 0 n "count-where returns 0 when no match")))

  ;; count works with composite PK model
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 102 @"B")))
    (let-do [n (Result.unsafe-from-success (Enrollment.count &db))]
      (SQLite3.close db)
      (assert-equal test 2 n "composite PK: count returns 2")))

  ;; count-where works with composite PK model
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"B+")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"C")))
    (let-do [n (Result.unsafe-from-success
               (Enrollment.count-where &db "sid = ?1" &[(to-sqlite3 1)]))]
      (SQLite3.close db)
      (assert-equal test 2 n "composite PK: count-where filters correctly")))

  ;; Long / Double / Bool round-trip through a second model
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Note.create-table &db))
    (ignore (Note.insert &db &(Note.init 0l @"title" @"body" 3.14 true)))
    (let-do [n (Result.unsafe-from-success (Note.find-by-id &db &1l))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          "title"
          (Note.title &n)
          "Note.title round-trips through SQLite"))
      (ignore
        (assert-equal test
          3.14
          @(Note.score &n)
          "Note.score round-trips as Double"))
      (assert-equal test
        true
        @(Note.pinned &n)
        "Note.pinned round-trips as Bool")))

  ;; create-table returns success
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.create-table &db)]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Success _) true (Result.Error _) false)
      "create-table returns Result.Success"))

  ;; insert on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.insert &db &(Todo.init 0 @"fail" false))]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "insert on missing table returns Result.Error"))

  ;; update on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.update &db &(Todo.init 1 @"fail" true))]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "update on missing table returns Result.Error"))

  ;; delete-by-id on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.delete-by-id &db &1)]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "delete-by-id on missing table returns Result.Error"))

  ;; begin and commit preserve data
  (let-do [db (fresh-db)]
    (ignore (ORM.begin SQLiteBackend &db))
    (ignore (insert-todo &db @"in txn" false))
    (ignore (ORM.commit SQLiteBackend &db))
    (let-do [rows (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (assert-equal test 1 (Array.length &rows) "commit preserves inserted row")))

  ;; begin and rollback undo data
  (let-do [db (fresh-db)]
    (ignore (ORM.begin SQLiteBackend &db))
    (ignore (insert-todo &db @"will rollback" false))
    (ignore (ORM.rollback SQLiteBackend &db))
    (let-do [rows (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (assert-equal test 0 (Array.length &rows) "rollback undoes inserted row")))

  ;; with-transaction commits on success
  (let-do [db (fresh-db)
           res (ORM.with-transaction SQLiteBackend
                                     &db
                                     (Todo.insert &db
                                                  &(Todo.init 0
                                                              @"committed"
                                                              false)))]
    (let-do [rows (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (ignore
        (assert-true test
          (match res (Result.Success _) true (Result.Error _) false)
          "with-transaction returns success on commit"))
      (assert-equal test
        1
        (Array.length &rows)
        "with-transaction commits data on success")))

  ;; with-transaction rolls back on error
  (let-do [db (fresh-db)
           res (ORM.with-transaction SQLiteBackend
                                     &db
                                     (do
                                       (ignore
                                         (Todo.insert &db
                                                      &(Todo.init 0
                                                                  @"temp"
                                                                  false)))
                                       (the (Result () String)
                                            (Result.Error @"deliberate"))))]
    (let-do [rows (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (ignore
        (assert-true test
          (match res (Result.Error _) true (Result.Success _) false)
          "with-transaction returns error on body failure"))
      (assert-equal test
        0
        (Array.length &rows)
        "with-transaction rolls back on error")))

  ;; with-transaction propagates the body result value
  (let-do [db (fresh-db)
           res (ORM.with-transaction SQLiteBackend
                                     &db
                                     (Todo.insert &db
                                                  &(Todo.init 0 @"get id" false)))]
    (SQLite3.close db)
    (assert-equal test
      1
      (Result.unsafe-from-success res)
      "with-transaction propagates the body result value"))

  ;; --- Composite primary key tests ---

  ;; create-table with composite PK succeeds
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Enrollment.create-table &db)]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Success _) true (Result.Error _) false)
      "composite PK: create-table succeeds"))

  ;; insert with composite PK returns ()
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (let-do [res (Enrollment.insert &db &(Enrollment.init 1 101 @"A"))]
      (SQLite3.close db)
      (assert-true test
        (match res (Result.Success _) true (Result.Error _) false)
        "composite PK: insert returns success")))

  ;; find-by-id with composite PK round-trips all fields
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"B+")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"C")))
    (let-do [e (Result.unsafe-from-success (Enrollment.find-by-id &db &1 &102))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          @(Enrollment.sid &e)
          "composite PK: find-by-id returns correct sid"))
      (ignore
        (assert-equal test
          102
          @(Enrollment.cid &e)
          "composite PK: find-by-id returns correct cid"))
      (assert-equal test
        "B+"
        (Enrollment.grade &e)
        "composite PK: find-by-id returns correct grade")))

  ;; find-by-id not found
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (let-do [res (Enrollment.find-by-id &db &99 &99)]
      (SQLite3.close db)
      (assert-true test
        (match res (Result.Error _) true (Result.Success _) false)
        "composite PK: find-by-id returns error when not found")))

  ;; update with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"B")))
    (ignore (Enrollment.update &db &(Enrollment.init 1 101 @"A+")))
    (let-do [e (Result.unsafe-from-success (Enrollment.find-by-id &db &1 &101))]
      (SQLite3.close db)
      (assert-equal test
        "A+"
        (Enrollment.grade &e)
        "composite PK: update modifies data field")))

  ;; delete-by-id with composite PK removes only the matching row
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"B")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"C")))
    (ignore (Enrollment.delete-by-id &db &1 &101))
    (let-do [remaining (Result.unsafe-from-success (Enrollment.find-all &db))]
      (SQLite3.close db)
      (assert-equal test
        2
        (Array.length &remaining)
        "composite PK: delete-by-id removes exactly one row")))

  ;; find-all with composite PK returns all rows
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 102 @"B")))
    (let-do [all (Result.unsafe-from-success (Enrollment.find-all &db))]
      (SQLite3.close db)
      (assert-equal test
        2
        (Array.length &all)
        "composite PK: find-all returns all rows"))))
