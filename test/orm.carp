(load "Test.carp")
(load "../backends/sqlite3.carp")

(use Test)

(deftype Todo [id Int
               text String
               done Bool])
(derive-model Todo SQLiteBackend [id Int])

(deftype Note [id Long
               title String
               body String
               score Double
               pinned Bool])
(derive-model Note SQLiteBackend [id Long])

; Composite PK model: a many-to-many join table
(deftype Enrollment [sid Int
                     cid Int
                     grade String])
(derive-model Enrollment SQLiteBackend [sid Int cid Int])

; Open a fresh in-memory DB and run the Todo table migration.
(defn fresh-db []
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Todo.create-table &db))
    db))

(defn insert-todo [db text done]
  (Result.unsafe-from-success (Todo.insert db &(Todo.init 0 text done))))

(deftest test
  ;; find-all returns empty after create-table
  (let-do [db (fresh-db)
           n (Array.length &(Result.unsafe-from-success (Todo.find-all &db)))]
    (SQLite3.close db)
    (assert-equal test 0 n "find-all returns 0 rows after create-table"))

  ;; insert returns sequential rowids
  (let-do [db (fresh-db)
           id1 (insert-todo &db @"buy milk" false)
           id2 (insert-todo &db @"write carp" true)]
    (SQLite3.close db)
    (ignore (assert-equal test 1 id1 "insert returns rowid 1 for first row"))
    (assert-equal test 2 id2 "insert returns rowid 2 for second row"))

  ;; find-by-id round-trips all fields
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (let-do [t (Result.unsafe-from-success (Todo.find-by-id &db &1))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          @(Todo.id &t)
          "find-by-id returns row with matching id"))
      (ignore
        (assert-equal test
          "buy milk"
          (Todo.text &t)
          "find-by-id returns row with stored text"))
      (assert-equal test
        false
        @(Todo.done &t)
        "find-by-id returns row with stored done flag")))

  ;; update writes data fields
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (ignore (Todo.update &db &(Todo.init 1 @"done task" true)))
    (let-do [t (Result.unsafe-from-success (Todo.find-by-id &db &1))]
      (SQLite3.close db)
      (ignore
        (assert-equal test "done task" (Todo.text &t) "update writes new text"))
      (assert-equal test true @(Todo.done &t) "update writes new done flag")))

  ;; delete-by-id removes only the matching row
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"keep" false))
    (ignore (insert-todo &db @"remove" false))
    (ignore (Todo.delete-by-id &db &2))
    (let-do [remaining (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          (Array.length &remaining)
          "delete-by-id removes exactly one row"))
      (assert-equal test
        "keep"
        (Todo.text (Array.unsafe-nth &remaining 0))
        "remaining row is the one that wasn't deleted")))

  ;; find-where filters by condition
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (let-do [done-items (Result.unsafe-from-success
               (Todo.find-where &db "done = ?1" &[(to-sqlite3 1)]))]
      (SQLite3.close db)
      (assert-equal test
        1
        (Array.length &done-items)
        "find-where returns only matching rows")))

  ;; find-where with multiple conditions
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (let-do [items (Result.unsafe-from-success
               (Todo.find-where &db
                                "done = ?1 AND text = ?2"
                                &[(to-sqlite3 0) (to-sqlite3 @"buy milk")]))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          (Array.length &items)
          "find-where with multiple conditions"))
      (assert-equal test
        "buy milk"
        (Todo.text (Array.unsafe-nth &items 0))
        "find-where returns correct row")))

  ;; find-where returns empty when no match
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [items (Result.unsafe-from-success
               (Todo.find-where &db "text = ?1" &[(to-sqlite3 @"nonexistent")]))]
      (SQLite3.close db)
      (assert-equal test
        0
        (Array.length &items)
        "find-where returns empty array when no match")))

  ;; count returns 0 on empty table
  (let-do [db (fresh-db)
           n (Result.unsafe-from-success (Todo.count &db))]
    (SQLite3.close db)
    (assert-equal test 0 n "count returns 0 on empty table"))

  ;; count returns correct number after inserts
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (let-do [n (Result.unsafe-from-success (Todo.count &db))]
      (SQLite3.close db)
      (assert-equal test 3 n "count returns 3 after three inserts")))

  ;; count-where returns matching count
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (let-do [n (Result.unsafe-from-success
               (Todo.count-where &db "done = ?1" &[(to-sqlite3 0)]))]
      (SQLite3.close db)
      (assert-equal test 2 n "count-where returns 2 for done=false")))

  ;; count-where returns 0 when no match
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [n (Result.unsafe-from-success
               (Todo.count-where &db "text = ?1" &[(to-sqlite3 @"nonexistent")]))]
      (SQLite3.close db)
      (assert-equal test 0 n "count-where returns 0 when no match")))

  ;; count works with composite PK model
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 102 @"B")))
    (let-do [n (Result.unsafe-from-success (Enrollment.count &db))]
      (SQLite3.close db)
      (assert-equal test 2 n "composite PK: count returns 2")))

  ;; count-where works with composite PK model
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"B+")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"C")))
    (let-do [n (Result.unsafe-from-success
               (Enrollment.count-where &db "sid = ?1" &[(to-sqlite3 1)]))]
      (SQLite3.close db)
      (assert-equal test 2 n "composite PK: count-where filters correctly")))

  ;; Long / Double / Bool round-trip through a second model
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Note.create-table &db))
    (ignore (Note.insert &db &(Note.init 0l @"title" @"body" 3.14 true)))
    (let-do [n (Result.unsafe-from-success (Note.find-by-id &db &1l))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          "title"
          (Note.title &n)
          "Note.title round-trips through SQLite"))
      (ignore
        (assert-equal test
          3.14
          @(Note.score &n)
          "Note.score round-trips as Double"))
      (assert-equal test
        true
        @(Note.pinned &n)
        "Note.pinned round-trips as Bool")))

  ;; create-table returns success
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.create-table &db)]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Success _) true (Result.Error _) false)
      "create-table returns Result.Success"))

  ;; insert on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.insert &db &(Todo.init 0 @"fail" false))]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "insert on missing table returns Result.Error"))

  ;; update on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.update &db &(Todo.init 1 @"fail" true))]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "update on missing table returns Result.Error"))

  ;; delete-by-id on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.delete-by-id &db &1)]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "delete-by-id on missing table returns Result.Error"))

  ;; begin and commit preserve data
  (let-do [db (fresh-db)]
    (ignore (ORM.begin SQLiteBackend &db))
    (ignore (insert-todo &db @"in txn" false))
    (ignore (ORM.commit SQLiteBackend &db))
    (let-do [rows (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (assert-equal test 1 (Array.length &rows) "commit preserves inserted row")))

  ;; begin and rollback undo data
  (let-do [db (fresh-db)]
    (ignore (ORM.begin SQLiteBackend &db))
    (ignore (insert-todo &db @"will rollback" false))
    (ignore (ORM.rollback SQLiteBackend &db))
    (let-do [rows (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (assert-equal test 0 (Array.length &rows) "rollback undoes inserted row")))

  ;; with-transaction commits on success
  (let-do [db (fresh-db)
           res (ORM.with-transaction SQLiteBackend
                                     &db
                                     (Todo.insert &db
                                                  &(Todo.init 0
                                                              @"committed"
                                                              false)))]
    (let-do [rows (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (ignore
        (assert-true test
          (match res (Result.Success _) true (Result.Error _) false)
          "with-transaction returns success on commit"))
      (assert-equal test
        1
        (Array.length &rows)
        "with-transaction commits data on success")))

  ;; with-transaction rolls back on error
  (let-do [db (fresh-db)
           res (ORM.with-transaction SQLiteBackend
                                     &db
                                     (do
                                       (ignore
                                         (Todo.insert &db
                                                      &(Todo.init 0
                                                                  @"temp"
                                                                  false)))
                                       (the (Result () String)
                                            (Result.Error @"deliberate"))))]
    (let-do [rows (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (ignore
        (assert-true test
          (match res (Result.Error _) true (Result.Success _) false)
          "with-transaction returns error on body failure"))
      (assert-equal test
        0
        (Array.length &rows)
        "with-transaction rolls back on error")))

  ;; with-transaction propagates the body result value
  (let-do [db (fresh-db)
           res (ORM.with-transaction SQLiteBackend
                                     &db
                                     (Todo.insert &db
                                                  &(Todo.init 0 @"get id" false)))]
    (SQLite3.close db)
    (assert-equal test
      1
      (Result.unsafe-from-success res)
      "with-transaction propagates the body result value"))

  ;; --- Composite primary key tests ---

  ;; create-table with composite PK succeeds
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Enrollment.create-table &db)]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Success _) true (Result.Error _) false)
      "composite PK: create-table succeeds"))

  ;; insert with composite PK returns ()
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (let-do [res (Enrollment.insert &db &(Enrollment.init 1 101 @"A"))]
      (SQLite3.close db)
      (assert-true test
        (match res (Result.Success _) true (Result.Error _) false)
        "composite PK: insert returns success")))

  ;; find-by-id with composite PK round-trips all fields
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"B+")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"C")))
    (let-do [e (Result.unsafe-from-success (Enrollment.find-by-id &db &1 &102))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          @(Enrollment.sid &e)
          "composite PK: find-by-id returns correct sid"))
      (ignore
        (assert-equal test
          102
          @(Enrollment.cid &e)
          "composite PK: find-by-id returns correct cid"))
      (assert-equal test
        "B+"
        (Enrollment.grade &e)
        "composite PK: find-by-id returns correct grade")))

  ;; find-by-id not found
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (let-do [res (Enrollment.find-by-id &db &99 &99)]
      (SQLite3.close db)
      (assert-true test
        (match res (Result.Error _) true (Result.Success _) false)
        "composite PK: find-by-id returns error when not found")))

  ;; update with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"B")))
    (ignore (Enrollment.update &db &(Enrollment.init 1 101 @"A+")))
    (let-do [e (Result.unsafe-from-success (Enrollment.find-by-id &db &1 &101))]
      (SQLite3.close db)
      (assert-equal test
        "A+"
        (Enrollment.grade &e)
        "composite PK: update modifies data field")))

  ;; delete-by-id with composite PK removes only the matching row
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"B")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"C")))
    (ignore (Enrollment.delete-by-id &db &1 &101))
    (let-do [remaining (Result.unsafe-from-success (Enrollment.find-all &db))]
      (SQLite3.close db)
      (assert-equal test
        2
        (Array.length &remaining)
        "composite PK: delete-by-id removes exactly one row")))

  ;; find-all with composite PK returns all rows
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 102 @"B")))
    (let-do [all (Result.unsafe-from-success (Enrollment.find-all &db))]
      (SQLite3.close db)
      (assert-equal test
        2
        (Array.length &all)
        "composite PK: find-all returns all rows")))

  ;; --- delete-where tests ---

  ;; delete-where removes matching rows
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (ignore (Todo.delete-where &db "done = ?1" &[(to-sqlite3 0)]))
    (let-do [remaining (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          (Array.length &remaining)
          "delete-where removes matching rows"))
      (assert-equal test
        "write carp"
        (Todo.text (Array.unsafe-nth &remaining 0))
        "delete-where keeps non-matching rows")))

  ;; delete-where with no matches is a no-op
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (ignore (Todo.delete-where &db "text = ?1" &[(to-sqlite3 @"nonexistent")]))
    (let-do [n (Result.unsafe-from-success (Todo.count &db))]
      (SQLite3.close db)
      (assert-equal test 1 n "delete-where with no matches is a no-op")))

  ;; delete-where on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.delete-where &db "done = ?1" &[(to-sqlite3 0)])]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "delete-where on missing table returns error"))

  ;; delete-where with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"B+")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"C")))
    (ignore (Enrollment.delete-where &db "sid = ?1" &[(to-sqlite3 1)]))
    (let-do [n (Result.unsafe-from-success (Enrollment.count &db))]
      (SQLite3.close db)
      (assert-equal test 1 n "composite PK: delete-where removes matching rows")))

  ;; --- update-where tests ---

  ;; update-where updates matching rows
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (ignore
      (Todo.update-where &db
                         "done = ?1"
                         "done = ?2"
                         &[(to-sqlite3 1) (to-sqlite3 0)]))
    (let-do [items (Result.unsafe-from-success (Todo.find-all &db))]
      (SQLite3.close db)
      (assert-equal test
        0
        (Array.length &(Array.copy-filter &(fn [t] (not @(Todo.done t))) &items))
        "update-where sets all not-done to done")))

  ;; update-where with no matches is a no-op
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (ignore
      (Todo.update-where &db
                         "done = ?1"
                         "text = ?2"
                         &[(to-sqlite3 1) (to-sqlite3 @"nonexistent")]))
    (let-do [t (Result.unsafe-from-success (Todo.find-by-id &db &1))]
      (SQLite3.close db)
      (assert-equal test
        false
        @(Todo.done &t)
        "update-where with no matches is a no-op")))

  ;; update-where can set multiple columns
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"old text" false))
    (ignore
      (Todo.update-where &db
                         "text = ?1, done = ?2"
                         "id = ?3"
                         &[(to-sqlite3 @"new text")
                           (to-sqlite3 1)
                           (to-sqlite3 1)]))
    (let-do [t (Result.unsafe-from-success (Todo.find-by-id &db &1))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          "new text"
          (Todo.text &t)
          "update-where sets text column"))
      (assert-equal test true @(Todo.done &t) "update-where sets done column")))

  ;; update-where on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.update-where &db
                                  "done = ?1"
                                  "id = ?2"
                                  &[(to-sqlite3 1) (to-sqlite3 1)])]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "update-where on missing table returns error"))

  ;; update-where with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"B")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"C")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"D")))
    (ignore
      (Enrollment.update-where &db
                               "grade = ?1"
                               "sid = ?2"
                               &[(to-sqlite3 @"A+") (to-sqlite3 1)]))
    (let-do [e1 (Result.unsafe-from-success (Enrollment.find-by-id &db &1 &101))
             e2 (Result.unsafe-from-success (Enrollment.find-by-id &db &1 &102))
             e3 (Result.unsafe-from-success (Enrollment.find-by-id &db &2 &101))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          "A+"
          (Enrollment.grade &e1)
          "composite PK: update-where updates first matching row"))
      (ignore
        (assert-equal test
          "A+"
          (Enrollment.grade &e2)
          "composite PK: update-where updates second matching row"))
      (assert-equal test
        "D"
        (Enrollment.grade &e3)
        "composite PK: update-where leaves non-matching row")))

  ;; --- find-first tests ---

  ;; find-first returns a row from a non-empty table
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (let-do [t (Result.unsafe-from-success (Todo.find-first &db))]
      (SQLite3.close db)
      (assert-equal test "buy milk" (Todo.text &t) "find-first returns a row")))

  ;; find-first returns error on empty table
  (let-do [db (fresh-db)
           res (Todo.find-first &db)]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "find-first returns error on empty table"))

  ;; find-first on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.find-first &db)]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "find-first on missing table returns error"))

  ;; find-first with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (let-do [e (Result.unsafe-from-success (Enrollment.find-first &db))]
      (SQLite3.close db)
      (assert-equal test
        "A"
        (Enrollment.grade &e)
        "composite PK: find-first returns a row")))

  ;; --- find-first-where tests ---

  ;; find-first-where returns the first matching row
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (ignore (insert-todo &db @"wash dishes" false))
    (let-do [t (Result.unsafe-from-success
               (Todo.find-first-where &db "done = ?1" &[(to-sqlite3 0)]))]
      (SQLite3.close db)
      (assert-equal test
        "buy milk"
        (Todo.text &t)
        "find-first-where returns a matching row")))

  ;; find-first-where returns error when no match
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [res (Todo.find-first-where &db
                                        "text = ?1"
                                        &[(to-sqlite3 @"nonexistent")])]
      (SQLite3.close db)
      (assert-true test
        (match res (Result.Error _) true (Result.Success _) false)
        "find-first-where returns error when no match")))

  ;; find-first-where with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"B+")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"C")))
    (let-do [e (Result.unsafe-from-success
               (Enrollment.find-first-where &db "sid = ?1" &[(to-sqlite3 1)]))]
      (SQLite3.close db)
      (assert-equal test
        1
        @(Enrollment.sid &e)
        "composite PK: find-first-where returns matching row")))

  ;; --- exists? tests ---

  ;; exists? returns true when rows match
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"buy milk" false))
    (ignore (insert-todo &db @"write carp" true))
    (let-do [res (Result.unsafe-from-success
               (Todo.exists? &db "done = ?1" &[(to-sqlite3 1)]))]
      (SQLite3.close db)
      (assert-true test res "exists? returns true when rows match")))

  ;; exists? returns false when no rows match
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [res (Result.unsafe-from-success
               (Todo.exists? &db "text = ?1" &[(to-sqlite3 @"nonexistent")]))]
      (SQLite3.close db)
      (assert-equal test false res "exists? returns false when no match")))

  ;; exists? returns false on empty table
  (let-do [db (fresh-db)
           res (Result.unsafe-from-success
             (Todo.exists? &db "done = ?1" &[(to-sqlite3 1)]))]
    (SQLite3.close db)
    (assert-equal test false res "exists? returns false on empty table"))

  ;; exists? on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           res (Todo.exists? &db "done = ?1" &[(to-sqlite3 1)])]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "exists? on missing table returns error"))

  ;; exists? with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 102 @"B")))
    (let-do [yes (Result.unsafe-from-success
               (Enrollment.exists? &db "sid = ?1" &[(to-sqlite3 1)]))
             no (Result.unsafe-from-success
               (Enrollment.exists? &db "sid = ?1" &[(to-sqlite3 99)]))]
      (SQLite3.close db)
      (ignore
        (assert-true test yes "composite PK: exists? true for matching sid"))
      (assert-equal test
        false
        no
        "composite PK: exists? false for non-matching sid")))

  ;; --- find-ordered tests ---

  ;; find-ordered sorts rows by the given clause
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"banana" false))
    (ignore (insert-todo &db @"apple" true))
    (ignore (insert-todo &db @"cherry" false))
    (let-do [items (Result.unsafe-from-success (Todo.find-ordered &db "text ASC"))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          3
          (Array.length &items)
          "find-ordered returns all rows"))
      (ignore
        (assert-equal test
          "apple"
          (Todo.text (Array.unsafe-nth &items 0))
          "find-ordered first row is apple"))
      (assert-equal test
        "cherry"
        (Todo.text (Array.unsafe-nth &items 2))
        "find-ordered last row is cherry")))

  ;; find-ordered with DESC
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"banana" false))
    (ignore (insert-todo &db @"apple" true))
    (ignore (insert-todo &db @"cherry" false))
    (let-do [items (Result.unsafe-from-success (Todo.find-ordered &db
                                                                  "text DESC"))]
      (SQLite3.close db)
      (assert-equal test
        "cherry"
        (Todo.text (Array.unsafe-nth &items 0))
        "find-ordered DESC puts cherry first")))

  ;; find-ordered on empty table returns empty
  (let-do [db (fresh-db)
           items (Result.unsafe-from-success (Todo.find-ordered &db "text ASC"))]
    (SQLite3.close db)
    (assert-equal test
      0
      (Array.length &items)
      "find-ordered on empty table returns empty array"))

  ;; find-ordered with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"B")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 102 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 3 103 @"C")))
    (let-do [items (Result.unsafe-from-success
               (Enrollment.find-ordered &db "grade ASC"))]
      (SQLite3.close db)
      (assert-equal test
        "A"
        (Enrollment.grade (Array.unsafe-nth &items 0))
        "composite PK: find-ordered sorts by grade")))

  ;; --- find-where-ordered tests ---

  ;; find-where-ordered filters and sorts
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"banana" false))
    (ignore (insert-todo &db @"apple" true))
    (ignore (insert-todo &db @"cherry" false))
    (let-do [items (Result.unsafe-from-success
               (Todo.find-where-ordered &db
                                        "done = ?1"
                                        &[(to-sqlite3 0)]
                                        "text ASC"))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          2
          (Array.length &items)
          "find-where-ordered returns only matching rows"))
      (assert-equal test
        "banana"
        (Todo.text (Array.unsafe-nth &items 0))
        "find-where-ordered sorts filtered results")))

  ;; find-where-ordered returns empty when no match
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [items (Result.unsafe-from-success
               (Todo.find-where-ordered &db
                                        "text = ?1"
                                        &[(to-sqlite3 @"nonexistent")]
                                        "text ASC"))]
      (SQLite3.close db)
      (assert-equal test
        0
        (Array.length &items)
        "find-where-ordered returns empty when no match")))

  ;; --- find-page tests ---

  ;; find-page returns a page of sorted rows
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"cherry" false))
    (ignore (insert-todo &db @"apple" true))
    (ignore (insert-todo &db @"banana" false))
    (ignore (insert-todo &db @"date" true))
    (let-do [page (Result.unsafe-from-success (Todo.find-page &db "text ASC" 2 0))]
      (SQLite3.close db)
      (ignore
        (assert-equal test 2 (Array.length &page) "find-page returns limit rows"))
      (ignore
        (assert-equal test
          "apple"
          (Todo.text (Array.unsafe-nth &page 0))
          "find-page first page starts at apple"))
      (assert-equal test
        "banana"
        (Todo.text (Array.unsafe-nth &page 1))
        "find-page first page ends at banana")))

  ;; find-page with offset skips rows
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"cherry" false))
    (ignore (insert-todo &db @"apple" true))
    (ignore (insert-todo &db @"banana" false))
    (ignore (insert-todo &db @"date" true))
    (let-do [page (Result.unsafe-from-success (Todo.find-page &db "text ASC" 2 2))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          2
          (Array.length &page)
          "find-page second page has 2 rows"))
      (assert-equal test
        "cherry"
        (Todo.text (Array.unsafe-nth &page 0))
        "find-page second page starts at cherry")))

  ;; find-page past end returns fewer rows
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"apple" false))
    (ignore (insert-todo &db @"banana" true))
    (ignore (insert-todo &db @"cherry" false))
    (let-do [page (Result.unsafe-from-success (Todo.find-page &db "text ASC" 2 2))]
      (SQLite3.close db)
      (assert-equal test
        1
        (Array.length &page)
        "find-page past end returns remaining rows")))

  ;; find-page with offset past all rows returns empty
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [page (Result.unsafe-from-success (Todo.find-page &db
                                                              "id ASC"
                                                              10
                                                              100))]
      (SQLite3.close db)
      (assert-equal test
        0
        (Array.length &page)
        "find-page with large offset returns empty")))

  ;; find-page with limit 0 returns empty
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [page (Result.unsafe-from-success (Todo.find-page &db "id ASC" 0 0))]
      (SQLite3.close db)
      (assert-equal test
        0
        (Array.length &page)
        "find-page with limit 0 returns empty")))

  ;; find-page with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"B")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 102 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 3 103 @"C")))
    (let-do [page (Result.unsafe-from-success
               (Enrollment.find-page &db "grade ASC" 2 0))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          2
          (Array.length &page)
          "composite PK: find-page returns limit rows"))
      (assert-equal test
        "A"
        (Enrollment.grade (Array.unsafe-nth &page 0))
        "composite PK: find-page sorts correctly")))

  ;; --- find-where-page tests ---

  ;; find-where-page filters, sorts, and paginates
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"cherry" false))
    (ignore (insert-todo &db @"apple" true))
    (ignore (insert-todo &db @"banana" false))
    (ignore (insert-todo &db @"date" false))
    (ignore (insert-todo &db @"elderberry" true))
    (let-do [page (Result.unsafe-from-success
               (Todo.find-where-page &db
                                     "done = ?1"
                                     &[(to-sqlite3 0)]
                                     "text ASC"
                                     2
                                     0))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          2
          (Array.length &page)
          "find-where-page returns limit rows"))
      (ignore
        (assert-equal test
          "banana"
          (Todo.text (Array.unsafe-nth &page 0))
          "find-where-page first page starts correctly"))
      (assert-equal test
        "cherry"
        (Todo.text (Array.unsafe-nth &page 1))
        "find-where-page first page ends correctly")))

  ;; find-where-page second page
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"cherry" false))
    (ignore (insert-todo &db @"apple" true))
    (ignore (insert-todo &db @"banana" false))
    (ignore (insert-todo &db @"date" false))
    (ignore (insert-todo &db @"elderberry" true))
    (let-do [page (Result.unsafe-from-success
               (Todo.find-where-page &db
                                     "done = ?1"
                                     &[(to-sqlite3 0)]
                                     "text ASC"
                                     2
                                     2))]
      (SQLite3.close db)
      (assert-equal test
        1
        (Array.length &page)
        "find-where-page second page has remaining row")))

  ;; find-where-page returns empty when no match
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"task" false))
    (let-do [page (Result.unsafe-from-success
               (Todo.find-where-page &db
                                     "text = ?1"
                                     &[(to-sqlite3 @"nonexistent")]
                                     "text ASC"
                                     10
                                     0))]
      (SQLite3.close db)
      (assert-equal test
        0
        (Array.length &page)
        "find-where-page returns empty when no match")))

  ;; find-where-page with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 101 @"B")))
    (ignore (Enrollment.insert &db &(Enrollment.init 1 102 @"A")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 101 @"C")))
    (ignore (Enrollment.insert &db &(Enrollment.init 2 102 @"D")))
    (let-do [page (Result.unsafe-from-success
               (Enrollment.find-where-page &db
                                           "sid = ?1"
                                           &[(to-sqlite3 1)]
                                           "grade ASC"
                                           1
                                           0))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          1
          (Array.length &page)
          "composite PK: find-where-page limits correctly"))
      (assert-equal test
        "A"
        (Enrollment.grade (Array.unsafe-nth &page 0))
        "composite PK: find-where-page sorts and filters")))

  ;; --- batch-insert tests ---

  ;; batch-insert with empty array returns success
  (let-do [db (fresh-db)
           res (Todo.batch-insert &db &[])]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Success _) true (Result.Error _) false)
      "batch-insert with empty array returns success"))

  ;; batch-insert with empty array leaves table unchanged
  (let-do [db (fresh-db)]
    (ignore (insert-todo &db @"existing" false))
    (ignore (Todo.batch-insert &db &[]))
    (let-do [n (Result.unsafe-from-success (Todo.count &db))]
      (SQLite3.close db)
      (assert-equal test 1 n "batch-insert empty array leaves table unchanged")))

  ;; batch-insert inserts multiple rows
  (let-do [db (fresh-db)
           items [(Todo.init 0 @"buy milk" false)
                  (Todo.init 0 @"write carp" true)
                  (Todo.init 0 @"wash dishes" false)]
           res (Todo.batch-insert &db &items)]
    (let-do [n (Result.unsafe-from-success (Todo.count &db))]
      (SQLite3.close db)
      (ignore
        (assert-true test
          (match res (Result.Success _) true (Result.Error _) false)
          "batch-insert returns success"))
      (assert-equal test 3 n "batch-insert inserts all rows")))

  ;; batch-insert data is retrievable
  (let-do [db (fresh-db)
           items [(Todo.init 0 @"alpha" false) (Todo.init 0 @"beta" true)]]
    (ignore (Todo.batch-insert &db &items))
    (let-do [rows (Result.unsafe-from-success (Todo.find-ordered &db "text ASC"))]
      (SQLite3.close db)
      (ignore
        (assert-equal test
          "alpha"
          (Todo.text (Array.unsafe-nth &rows 0))
          "batch-insert first row text"))
      (ignore
        (assert-equal test
          false
          @(Todo.done (Array.unsafe-nth &rows 0))
          "batch-insert first row done flag"))
      (ignore
        (assert-equal test
          "beta"
          (Todo.text (Array.unsafe-nth &rows 1))
          "batch-insert second row text"))
      (assert-equal test
        true
        @(Todo.done (Array.unsafe-nth &rows 1))
        "batch-insert second row done flag")))

  ;; batch-insert single row
  (let-do [db (fresh-db)
           items [(Todo.init 0 @"solo" true)]]
    (ignore (Todo.batch-insert &db &items))
    (let-do [n (Result.unsafe-from-success (Todo.count &db))]
      (SQLite3.close db)
      (assert-equal test 1 n "batch-insert single row works")))

  ;; batch-insert on missing table returns error
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))
           items [(Todo.init 0 @"fail" false)]
           res (Todo.batch-insert &db &items)]
    (SQLite3.close db)
    (assert-true test
      (match res (Result.Error _) true (Result.Success _) false)
      "batch-insert on missing table returns error"))

  ;; batch-insert with composite PK
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (let-do [items [(Enrollment.init 1 101 @"A")
                    (Enrollment.init 2 102 @"B+")
                    (Enrollment.init 3 103 @"C")]
             res (Enrollment.batch-insert &db &items)]
      (let-do [n (Result.unsafe-from-success (Enrollment.count &db))]
        (SQLite3.close db)
        (ignore
          (assert-true test
            (match res (Result.Success _) true (Result.Error _) false)
            "composite PK: batch-insert returns success"))
        (assert-equal test 3 n "composite PK: batch-insert inserts all rows"))))

  ;; batch-insert composite PK data is retrievable
  (let-do [db (Result.unsafe-from-success (SQLite3.open ":memory:"))]
    (ignore (Enrollment.create-table &db))
    (let-do [items [(Enrollment.init 1 101 @"A") (Enrollment.init 2 102 @"B+")]]
      (ignore (Enrollment.batch-insert &db &items))
      (let-do [e (Result.unsafe-from-success (Enrollment.find-by-id &db &2 &102))]
        (SQLite3.close db)
        (assert-equal test
          "B+"
          (Enrollment.grade &e)
          "composite PK: batch-insert data is retrievable")))))
