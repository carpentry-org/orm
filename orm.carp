(load "git@github.com:carpentry-org/strbuf@0.1.0")

(doc ORM "is a database-agnostic ORM for Carp.

## Installation

Load a backend from the package. The SQLite backend pulls in the
ORM core and the `sqlite3` package transitively:

```
(load \"git@github.com:carpentry-org/orm@0.2.0\" \"backends/sqlite3.carp\")
```

## Usage

```
(load \"git@github.com:carpentry-org/orm@0.2.0\" \"backends/sqlite3.carp\")

(deftype Item [id Int text String done Bool])
(derive-model Item SQLiteBackend [id Int])

(defn main []
  (let-do [db (Result.unsafe-from-success (SQLite3.open \"app.db\"))]
    (ignore (Item.create-table &db))
    (ignore (Item.insert &db &(Item.init 0 @\"buy milk\" false)))
    (println* &(Item.find-all &db))
    (SQLite3.close db)))
```

`derive-model` reads the deftype's fields with `members` and emits CRUD
functions in the type's module. The SQL dialect and row marshalling are
delegated to a backend module, so the same model definition works against
any database with a backend.
")

(defmodule ORM
  (hidden join)
  (defndynamic join [sep xs]
    (if (empty? xs)
      ""
      (reduce (fn [acc x] (String.concat [acc sep x])) (car xs) (cdr xs))))

  (hidden pairs)
  (defndynamic pairs [xs]
    (if (empty? xs) [] (cons (list (car xs) (cadr xs)) (ORM.pairs (cddr xs)))))

  (hidden map-idx)
  (defndynamic map-idx [f xs]
    (let-do [i 0
             result (list)]
      (while-do (not (empty? xs))
        (set! result (append result (list (f i (car xs)))))
        (set! i (+ i 1))
        (set! xs (cdr xs)))
      result))

  (hidden member?)
  (defndynamic member? [x xs]
    (cond (empty? xs) false (= x (car xs)) true (ORM.member? x (cdr xs))))

  (hidden without)
  (defndynamic without [mems names]
    (cond
      (empty? mems) []
      (ORM.member? (car (car mems)) names) (ORM.without (cdr mems) names)
      (cons (car mems) (ORM.without (cdr mems) names))))

  (hidden backend-call)
  (defndynamic backend-call [backend fn-name args]
    (eval (cons (Symbol.prefix backend fn-name) args)))

  (hidden sql-type-for)
  (defndynamic sql-type-for [backend t]
    (ORM.backend-call backend 'sql-type (list (list 'quote t))))

  (hidden placeholder-for)
  (defndynamic placeholder-for [backend n]
    (ORM.backend-call backend 'placeholder (list n)))

  (hidden bind-for)
  (defndynamic bind-for [backend t expr]
    (ORM.backend-call backend
                      'bind-value
                      (list (list 'quote t) (list 'quote expr))))

  (hidden extract-for)
  (defndynamic extract-for [backend t var-sym]
    (ORM.backend-call backend
                      'extract-col
                      (list (list 'quote t) (list 'quote var-sym))))

  (hidden sql-col-defs)
  (defndynamic sql-col-defs [backend mems]
    (ORM.join ", "
              (map
                (fn [m]
                  (String.concat
                    [(str (car m)) " " (ORM.sql-type-for backend (cadr m))]))
                mems)))

  (hidden sql-col-names)
  (defndynamic sql-col-names [mems]
    (ORM.join ", " (map (fn [m] (str (car m))) mems)))

  (hidden sql-placeholders)
  (defndynamic sql-placeholders [backend mems offset]
    (ORM.join ", "
              (ORM.map-idx
                (fn [i _] (ORM.placeholder-for backend (+ i offset)))
                mems)))

  (hidden sql-where-eq)
  (defndynamic sql-where-eq [backend mems offset sep]
    (ORM.join sep
              (ORM.map-idx
                (fn [i m]
                  (String.concat
                    [(str (car m))
                     "="
                     (ORM.placeholder-for backend (+ i offset))]))
                mems)))

  (hidden row-accessor)
  (defndynamic row-accessor [name m] (list (Symbol.prefix name (car m)) 'row))

  (hidden bind-row-fields)
  (defndynamic bind-row-fields [backend name mems]
    (collect-into
      (map
        (fn [m] (ORM.bind-for backend (cadr m) (ORM.row-accessor name m)))
        mems)
      array))

  ; Single-PK models use `pk`; composite-PK models use `pk0`, `pk1`, ...
  (hidden pk-param-sym)
  (defndynamic pk-param-sym [n-pks i]
    (if (= 1 n-pks) 'pk (Symbol.from (String.concat ["pk" (str i)]))))

  (hidden pk-param-syms)
  (defndynamic pk-param-syms [pk-mems]
    (let [n (length pk-mems)]
      (ORM.map-idx (fn [i _] (ORM.pk-param-sym n i)) pk-mems)))

  (hidden bind-pk-args)
  (defndynamic bind-pk-args [backend pk-mems]
    (let [n (length pk-mems)]
      (collect-into
        (ORM.map-idx
          (fn [i m] (ORM.bind-for backend (cadr m) (ORM.pk-param-sym n i)))
          pk-mems)
        array)))

  ; Columns are copied into locals `c0`, `c1`, ... to satisfy the borrow checker.
  (hidden row-let-bindings)
  (defndynamic row-let-bindings [mems cols-form]
    (collect-into
      (reduce (fn [acc pair] (append acc pair))
              (list)
              (ORM.map-idx
                (fn [i _]
                  (list
                    (Symbol.from (String.concat ["c" (str i)]))
                    (list 'copy (list 'Array.unsafe-nth cols-form i))))
                mems))
      array))

  (hidden init-call-from-cols)
  (defndynamic init-call-from-cols [backend name mems]
    (cons (Symbol.prefix name 'init)
          (ORM.map-idx
            (fn [i m]
              (ORM.extract-for backend
                               (cadr m)
                               (Symbol.from (String.concat ["c" (str i)]))))
            mems)))

  (hidden agg-extract-body)
  (defndynamic agg-extract-body [query-sym backend sql-expr params-expr]
    (list 'match
          (list query-sym 'db sql-expr params-expr)
          '(Result.Error e)
          '(Result.Error e)
          '(Result.Success rows)
          (list 'if
                '(= (Array.length &rows) 0)
                '(Result.Error @"no rows returned")
                (list 'let-do
                      [(Symbol.from "c0")
                       '(copy (Array.unsafe-nth (Array.unsafe-nth &rows 0) 0))]
                      (list 'Result.Success
                            (ORM.extract-for backend 'Double (Symbol.from "c0"))))))))

(doc derive-model "generates CRUD functions for a type in its own module.

`name` is the deftype symbol. `backend` is a module providing the
[backend API](#backend-api). `pk-fields` is an array of `[field Type ...]`
describing the primary key (one or more fields).

For single-PK models, `insert` omits the PK column (auto-increment) and
returns the assigned rowid. For composite-PK models, `insert` includes
all fields and returns `(Result () String)`. `batch-insert` inserts
multiple rows in a single SQL statement and returns `(Result () String)`.
`find-by-id` and `delete-by-id` accept one argument per PK field.

`drop-table` removes the table from the database (safe to call even
if the table does not exist).

`upsert` inserts a row or updates the data fields if the primary key
already exists (INSERT ... ON CONFLICT DO UPDATE). All fields including
the PK must be set on the row.

`update-where` performs parameterized bulk updates with a SQL SET
clause and WHERE clause. `delete-where` performs parameterized bulk
deletes.

`find-ordered` and `find-where-ordered` accept an ORDER BY clause
(e.g. `\"text ASC\"`). `find-page` and `find-where-page` add
LIMIT/OFFSET pagination on top of ordering.

`sum`, `avg`, `min-val`, and `max-val` return aggregate values
for a named numeric column as `(Result Double String)`.
Each has a `-where` variant that accepts a WHERE clause and
bound parameters.

The generated functions live in the type's module.")
(defmacro derive-model [name backend pk-fields]
  (let [all-mems (eval (list 'members name))
        pk-mems (ORM.pairs pk-fields)
        pk-names (map car pk-mems)
        data-mems (ORM.without all-mems pk-names)
        table-name (str name)
        n-data (length data-mems)
        n-pk (length pk-mems)
        is-composite (< 1 n-pk)
        _ (cond
          (= 0 n-pk)
            (macro-error
              "derive-model: at least one primary-key field is required")
          (= 0 n-data)
            (macro-error
              (String.concat
                ["derive-model: "
                 (str name)
                 " has no non-PK fields to insert/update"]))
          ())
        col-defs (ORM.sql-col-defs backend all-mems)
        pk-name-str (ORM.join ", " (map str pk-names))
        all-names (ORM.sql-col-names all-mems)
        data-names (ORM.sql-col-names data-mems)
        data-placeholders (ORM.sql-placeholders backend data-mems 1)
        create-sql (String.concat
          ["CREATE TABLE IF NOT EXISTS "
           table-name
           " ("
           col-defs
           ", PRIMARY KEY ("
           pk-name-str
           "))"])
        drop-sql (String.concat ["DROP TABLE IF EXISTS " table-name])
        insert-names (if is-composite all-names data-names)
        insert-placeholders (if is-composite
          (ORM.sql-placeholders backend all-mems 1)
          data-placeholders)
        insert-sql (String.concat
          ["INSERT INTO "
           table-name
           " ("
           insert-names
           ")"
           " VALUES ("
           insert-placeholders
           ")"])
        select-all-sql (String.concat ["SELECT " all-names " FROM " table-name])
        select-where-prefix (String.concat
          ["SELECT " all-names " FROM " table-name " WHERE "])
        count-sql (String.concat ["SELECT COUNT(*) FROM " table-name])
        count-where-prefix (String.concat
          ["SELECT COUNT(*) FROM " table-name " WHERE "])
        sum-agg-prefix "SELECT CAST(SUM("
        avg-agg-prefix "SELECT CAST(AVG("
        min-agg-prefix "SELECT CAST(MIN("
        max-agg-prefix "SELECT CAST(MAX("
        agg-col-suffix (String.concat [") AS REAL) FROM " table-name])
        agg-col-where-suffix (String.concat
          [") AS REAL) FROM " table-name " WHERE "])
        select-by-pk-sql (String.concat
          ["SELECT "
           all-names
           " FROM "
           table-name
           " WHERE "
           (ORM.sql-where-eq backend pk-mems 1 " AND ")])
        delete-by-pk-sql (String.concat
          ["DELETE FROM "
           table-name
           " WHERE "
           (ORM.sql-where-eq backend pk-mems 1 " AND ")])
        update-sql (String.concat
          ["UPDATE "
           table-name
           " SET "
           (ORM.sql-where-eq backend data-mems 1 ", ")
           " WHERE "
           (ORM.sql-where-eq backend pk-mems (+ n-data 1) " AND ")])
        delete-where-prefix (String.concat ["DELETE FROM " table-name " WHERE "])
        update-where-prefix (String.concat ["UPDATE " table-name " SET "])
        select-first-sql (String.concat [select-all-sql " LIMIT 1"])
        last-id-sql (ORM.backend-call backend 'last-insert-id-sql (list))
        query-sym (ORM.backend-call backend 'query-fn (list))
        insert-mems (if is-composite all-mems data-mems)
        insert-binds (ORM.bind-row-fields backend name insert-mems)
        update-binds (collect-into
          (append
            (map
              (fn [m] (ORM.bind-for backend (cadr m) (ORM.row-accessor name m)))
              data-mems)
            (map
              (fn [m] (ORM.bind-for backend (cadr m) (ORM.row-accessor name m)))
              pk-mems))
          array)
        pk-params (ORM.pk-param-syms pk-mems)
        pk-binds (ORM.bind-pk-args backend pk-mems)
        batch-group (String.concat
          ["(" (ORM.join ", " (map (fn [_] "?") insert-mems)) ")"])
        batch-first-sql (String.concat
          ["INSERT INTO " table-name " (" insert-names ") VALUES " batch-group])
        batch-extra-group (String.concat [", " batch-group])
        batch-push-forms (cons 'do
                               (map
                                 (fn [m]
                                   (list 'set!
                                         'binds
                                         (list 'Array.push-back
                                               'binds
                                               (ORM.bind-for backend
                                                             (cadr m)
                                                             (ORM.row-accessor name
                                                                               m)))))
                                 insert-mems))
        upsert-set-clause (ORM.join ", "
                                    (map
                                      (fn [m]
                                        (String.concat
                                          [(str (car m))
                                           "=excluded."
                                           (str (car m))]))
                                      data-mems))
        upsert-sql (String.concat
          ["INSERT INTO "
           table-name
           " ("
           all-names
           ") VALUES ("
           (ORM.sql-placeholders backend all-mems 1)
           ") ON CONFLICT ("
           pk-name-str
           ") DO UPDATE SET "
           upsert-set-clause])
        upsert-binds (ORM.bind-row-fields backend name all-mems)]
    (eval (list 'defmodule
                name

                (list 'defn
                      'create-table
                      ['db]
                      (list 'match
                            (list query-sym 'db create-sql '&[])
                            '(Result.Success _)
                            '(Result.Success ())
                            '(Result.Error e)
                            '(Result.Error e)))

                (list 'doc 'drop-table "drops the table if it exists.

Returns `(Result () String)`. Safe to call even if the table
does not exist.")
                (list 'defn
                      'drop-table
                      ['db]
                      (list 'match
                            (list query-sym 'db drop-sql '&[])
                            '(Result.Success _)
                            '(Result.Success ())
                            '(Result.Error e)
                            '(Result.Error e)))

                (if is-composite
                  (list 'defn
                        'insert
                        ['db 'row]
                        (list 'match
                              (list query-sym
                                    'db
                                    insert-sql
                                    (list 'ref insert-binds))
                              '(Result.Success _)
                              '(Result.Success ())
                              '(Result.Error e)
                              '(Result.Error e)))
                  (list 'defn
                        'insert
                        ['db 'row]
                        (list 'match
                              (list query-sym
                                    'db
                                    insert-sql
                                    (list 'ref insert-binds))
                              '(Result.Error e)
                              '(Result.Error e)
                              '(Result.Success _)
                              (list 'match
                                    (list query-sym 'db last-id-sql '&[])
                                    '(Result.Error e2)
                                    '(Result.Error e2)
                                    '(Result.Success rows)
                                    (list 'if
                                          '(= (Array.length &rows) 0)
                                          '(Result.Error @"no rowid returned")
                                          (list 'let-do
                                                [(Symbol.from "c0")
                                                 '(copy
                                                   (Array.unsafe-nth (Array.unsafe-nth &rows
                                                                                       0)
                                                                     0))]
                                                (list 'Result.Success
                                                      (ORM.extract-for backend
                                                                       'Int
                                                                       (Symbol.from "c0")))))))))

                (list 'doc
                      'batch-insert
                      "inserts multiple rows in a single SQL statement.

`rows` is a ref to an array of values to insert. Returns
`(Result () String)`.

This is more efficient than calling `insert` in a loop because it
sends a single `INSERT ... VALUES (...), (...), ...` statement to
the database.")
                (list 'defn
                      'batch-insert
                      ['db 'rows]
                      (list 'if
                            '(= (Array.length rows) 0)
                            '(Result.Success ())
                            (list 'let
                                  ['n
                                   '(Array.length rows)
                                   'buf
                                   '(StringBuf.create)
                                   'binds
                                   '(Array.zero)]
                                  (list 'do
                                        (list 'StringBuf.append-str
                                              '&buf
                                              batch-first-sql)
                                        (list 'for
                                              ['i 1 'n]
                                              (list 'StringBuf.append-str
                                                    '&buf
                                                    batch-extra-group))
                                        (list 'let-do
                                              ['sql '(StringBuf.to-string &buf)]
                                              (list 'for
                                                    ['i 0 'n]
                                                    (list 'let
                                                          ['row
                                                           '(Array.unsafe-nth rows
                                                                              i)]
                                                          batch-push-forms))
                                              (list 'match
                                                    (list query-sym
                                                          'db
                                                          '&sql
                                                          '&binds)
                                                    '(Result.Success _)
                                                    '(Result.Success ())
                                                    '(Result.Error e)
                                                    '(Result.Error e)))))))

                (list 'doc
                      'upsert
                      "inserts a row, or updates the data fields if the primary
key already exists.

Uses INSERT ... ON CONFLICT DO UPDATE to atomically insert or
update in a single statement. All fields (including PK) must
be set on the row. Returns `(Result () String)`.")
                (list 'defn
                      'upsert
                      ['db 'row]
                      (list 'match
                            (list query-sym
                                  'db
                                  upsert-sql
                                  (list 'ref upsert-binds))
                            '(Result.Success _)
                            '(Result.Success ())
                            '(Result.Error e)
                            '(Result.Error e)))

                (list 'defn
                      'find-all
                      ['db]
                      (list 'match
                            (list query-sym 'db select-all-sql '&[])
                            '(Result.Error e)
                            '(Result.Error e)
                            '(Result.Success rows)
                            (list 'Result.Success
                                  (list 'Array.copy-map
                                        (list 'ref
                                              (list 'fn
                                                    ['cols]
                                                    (list 'let-do
                                                          (ORM.row-let-bindings all-mems
                                                                                'cols)
                                                          (ORM.init-call-from-cols backend
                                                                                   name
                                                                                   all-mems))))
                                        '&rows))))

                (list 'doc
                      'find-where
                      "returns rows matching a SQL WHERE clause.

`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`) and
`params` is a ref to an array of bound parameters.")
                (list 'defn
                      'find-where
                      ['db 'where-clause 'params]
                      (list 'let
                            ['sql
                             (list 'String.append
                                   select-where-prefix
                                   'where-clause)]
                            (list 'match
                                  (list query-sym 'db '&sql 'params)
                                  '(Result.Error e)
                                  '(Result.Error e)
                                  '(Result.Success rows)
                                  (list 'Result.Success
                                        (list 'Array.copy-map
                                              (list 'ref
                                                    (list 'fn
                                                          ['cols]
                                                          (list 'let-do
                                                                (ORM.row-let-bindings all-mems
                                                                                      'cols)
                                                                (ORM.init-call-from-cols backend
                                                                                         name
                                                                                         all-mems))))
                                              '&rows)))))

                (list 'doc
                      'count
                      "returns the total number of rows in the table.")
                (list 'defn
                      'count
                      ['db]
                      (list 'match
                            (list query-sym 'db count-sql '&[])
                            '(Result.Error e)
                            '(Result.Error e)
                            '(Result.Success rows)
                            (list 'if
                                  '(= (Array.length &rows) 0)
                                  '(Result.Error @"no rows returned")
                                  (list 'let-do
                                        [(Symbol.from "c0")
                                         '(copy
                                           (Array.unsafe-nth (Array.unsafe-nth &rows
                                                                               0)
                                                             0))]
                                        (list 'Result.Success
                                              (ORM.extract-for backend
                                                               'Int
                                                               (Symbol.from "c0")))))))

                (list 'doc
                      'count-where
                      "returns the count of rows matching a SQL WHERE clause.

`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`) and
`params` is a ref to an array of bound parameters.")
                (list 'defn
                      'count-where
                      ['db 'where-clause 'params]
                      (list 'let
                            ['sql
                             (list 'String.append
                                   count-where-prefix
                                   'where-clause)]
                            (list 'match
                                  (list query-sym 'db '&sql 'params)
                                  '(Result.Error e)
                                  '(Result.Error e)
                                  '(Result.Success rows)
                                  (list 'if
                                        '(= (Array.length &rows) 0)
                                        '(Result.Error @"no rows returned")
                                        (list 'let-do
                                              [(Symbol.from "c0")
                                               '(copy
                                                 (Array.unsafe-nth (Array.unsafe-nth &rows
                                                                                     0)
                                                                   0))]
                                              (list 'Result.Success
                                                    (ORM.extract-for backend
                                                                     'Int
                                                                     (Symbol.from "c0"))))))))

                (list 'doc
                      'sum
                      "returns the sum of a numeric column as a Double.

`col` is the column name (e.g. `\"score\"`). Returns 0.0 for
empty tables or NULL values.")
                (list 'defn
                      'sum
                      ['db 'col]
                      (list 'let
                            ['s1
                             (list 'String.append sum-agg-prefix 'col)
                             'sql
                             (list 'String.append '&s1 agg-col-suffix)]
                            (ORM.agg-extract-body query-sym backend '&sql '&[])))

                (list 'doc
                      'sum-where
                      "returns the sum of a numeric column matching a SQL
WHERE clause.

`col` is the column name (e.g. `\"score\"`),
`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`) and
`params` is a ref to an array of bound parameters.")
                (list 'defn
                      'sum-where
                      ['db 'col 'where-clause 'params]
                      (list 'let
                            ['s1
                             (list 'String.append sum-agg-prefix 'col)
                             's2
                             (list 'String.append '&s1 agg-col-where-suffix)
                             'sql
                             (list 'String.append '&s2 'where-clause)]
                            (ORM.agg-extract-body query-sym
                                                  backend
                                                  '&sql
                                                  'params)))

                (list 'doc
                      'avg
                      "returns the average of a numeric column as a Double.

`col` is the column name (e.g. `\"score\"`). Returns 0.0 for
empty tables or NULL values.")
                (list 'defn
                      'avg
                      ['db 'col]
                      (list 'let
                            ['s1
                             (list 'String.append avg-agg-prefix 'col)
                             'sql
                             (list 'String.append '&s1 agg-col-suffix)]
                            (ORM.agg-extract-body query-sym backend '&sql '&[])))

                (list 'doc
                      'avg-where
                      "returns the average of a numeric column matching a SQL
WHERE clause.

`col` is the column name (e.g. `\"score\"`),
`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`) and
`params` is a ref to an array of bound parameters.")
                (list 'defn
                      'avg-where
                      ['db 'col 'where-clause 'params]
                      (list 'let
                            ['s1
                             (list 'String.append avg-agg-prefix 'col)
                             's2
                             (list 'String.append '&s1 agg-col-where-suffix)
                             'sql
                             (list 'String.append '&s2 'where-clause)]
                            (ORM.agg-extract-body query-sym
                                                  backend
                                                  '&sql
                                                  'params)))

                (list 'doc
                      'min-val
                      "returns the minimum of a numeric column as a Double.

`col` is the column name (e.g. `\"score\"`). Returns 0.0 for
empty tables or NULL values.")
                (list 'defn
                      'min-val
                      ['db 'col]
                      (list 'let
                            ['s1
                             (list 'String.append min-agg-prefix 'col)
                             'sql
                             (list 'String.append '&s1 agg-col-suffix)]
                            (ORM.agg-extract-body query-sym backend '&sql '&[])))

                (list 'doc
                      'min-val-where
                      "returns the minimum of a numeric column matching a SQL
WHERE clause.

`col` is the column name (e.g. `\"score\"`),
`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`) and
`params` is a ref to an array of bound parameters.")
                (list 'defn
                      'min-val-where
                      ['db 'col 'where-clause 'params]
                      (list 'let
                            ['s1
                             (list 'String.append min-agg-prefix 'col)
                             's2
                             (list 'String.append '&s1 agg-col-where-suffix)
                             'sql
                             (list 'String.append '&s2 'where-clause)]
                            (ORM.agg-extract-body query-sym
                                                  backend
                                                  '&sql
                                                  'params)))

                (list 'doc
                      'max-val
                      "returns the maximum of a numeric column as a Double.

`col` is the column name (e.g. `\"score\"`). Returns 0.0 for
empty tables or NULL values.")
                (list 'defn
                      'max-val
                      ['db 'col]
                      (list 'let
                            ['s1
                             (list 'String.append max-agg-prefix 'col)
                             'sql
                             (list 'String.append '&s1 agg-col-suffix)]
                            (ORM.agg-extract-body query-sym backend '&sql '&[])))

                (list 'doc
                      'max-val-where
                      "returns the maximum of a numeric column matching a SQL
WHERE clause.

`col` is the column name (e.g. `\"score\"`),
`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`) and
`params` is a ref to an array of bound parameters.")
                (list 'defn
                      'max-val-where
                      ['db 'col 'where-clause 'params]
                      (list 'let
                            ['s1
                             (list 'String.append max-agg-prefix 'col)
                             's2
                             (list 'String.append '&s1 agg-col-where-suffix)
                             'sql
                             (list 'String.append '&s2 'where-clause)]
                            (ORM.agg-extract-body query-sym
                                                  backend
                                                  '&sql
                                                  'params)))

                (list 'defn
                      'find-by-id
                      (collect-into (cons 'db pk-params) array)
                      (list 'match
                            (list query-sym
                                  'db
                                  select-by-pk-sql
                                  (list 'ref pk-binds))
                            '(Result.Error e)
                            '(Result.Error e)
                            '(Result.Success rows)
                            (list 'if
                                  '(= (Array.length &rows) 0)
                                  '(Result.Error @"not found")
                                  (list 'let-do
                                        (ORM.row-let-bindings all-mems
                                                              '(Array.unsafe-nth &rows
                                                                                 0))
                                        (list 'Result.Success
                                              (ORM.init-call-from-cols backend
                                                                       name
                                                                       all-mems))))))

                (list 'defn
                      'update
                      ['db 'row]
                      (list 'match
                            (list query-sym
                                  'db
                                  update-sql
                                  (list 'ref update-binds))
                            '(Result.Success _)
                            '(Result.Success ())
                            '(Result.Error e)
                            '(Result.Error e)))

                (list 'defn
                      'delete-by-id
                      (collect-into (cons 'db pk-params) array)
                      (list 'match
                            (list query-sym
                                  'db
                                  delete-by-pk-sql
                                  (list 'ref pk-binds))
                            '(Result.Success _)
                            '(Result.Success ())
                            '(Result.Error e)
                            '(Result.Error e)))

                (list 'doc
                      'delete-where
                      "deletes rows matching a SQL WHERE clause.

`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`) and
`params` is a ref to an array of bound parameters.")
                (list 'defn
                      'delete-where
                      ['db 'where-clause 'params]
                      (list 'let
                            ['sql
                             (list 'String.append
                                   delete-where-prefix
                                   'where-clause)]
                            (list 'match
                                  (list query-sym 'db '&sql 'params)
                                  '(Result.Success _)
                                  '(Result.Success ())
                                  '(Result.Error e)
                                  '(Result.Error e))))

                (list 'doc
                      'update-where
                      "updates rows matching a SQL WHERE clause.

`set-clause` is a SQL SET fragment (e.g. `\"done = ?1\"`) and
`where-clause` is a SQL WHERE fragment (e.g. `\"text = ?2\"`) and
`params` is a ref to an array of bound parameters covering
both clauses.")
                (list 'defn
                      'update-where
                      ['db 'set-clause 'where-clause 'params]
                      (list 'let
                            ['base
                             (list 'String.append
                                   update-where-prefix
                                   'set-clause)
                             's1
                             (list 'String.append '&base " WHERE ")
                             'sql
                             (list 'String.append '&s1 'where-clause)]
                            (list 'match
                                  (list query-sym 'db '&sql 'params)
                                  '(Result.Success _)
                                  '(Result.Success ())
                                  '(Result.Error e)
                                  '(Result.Error e))))

                (list 'doc
                      'find-first
                      "returns the first row from the table, or an error if
the table is empty.")
                (list 'defn
                      'find-first
                      ['db]
                      (list 'match
                            (list query-sym 'db select-first-sql '&[])
                            '(Result.Error e)
                            '(Result.Error e)
                            '(Result.Success rows)
                            (list 'if
                                  '(= (Array.length &rows) 0)
                                  '(Result.Error @"not found")
                                  (list 'let-do
                                        (ORM.row-let-bindings all-mems
                                                              '(Array.unsafe-nth &rows
                                                                                 0))
                                        (list 'Result.Success
                                              (ORM.init-call-from-cols backend
                                                                       name
                                                                       all-mems))))))

                (list 'doc
                      'find-first-where
                      "returns the first row matching a SQL WHERE clause, or
an error if no rows match.

`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`) and
`params` is a ref to an array of bound parameters.")
                (list 'defn
                      'find-first-where
                      ['db 'where-clause 'params]
                      (list 'let
                            ['base
                             (list 'String.append
                                   select-where-prefix
                                   'where-clause)
                             'sql
                             (list 'String.append '&base " LIMIT 1")]
                            (list 'match
                                  (list query-sym 'db '&sql 'params)
                                  '(Result.Error e)
                                  '(Result.Error e)
                                  '(Result.Success rows)
                                  (list 'if
                                        '(= (Array.length &rows) 0)
                                        '(Result.Error @"not found")
                                        (list 'let-do
                                              (ORM.row-let-bindings all-mems
                                                                    '(Array.unsafe-nth &rows
                                                                                       0))
                                              (list 'Result.Success
                                                    (ORM.init-call-from-cols backend
                                                                             name
                                                                             all-mems)))))))

                (list 'doc
                      'exists?
                      "returns whether any rows match a SQL WHERE clause.

`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`) and
`params` is a ref to an array of bound parameters.")
                (list 'defn
                      'exists?
                      ['db 'where-clause 'params]
                      (list 'let
                            ['sql
                             (list 'String.append
                                   count-where-prefix
                                   'where-clause)]
                            (list 'match
                                  (list query-sym 'db '&sql 'params)
                                  '(Result.Error e)
                                  '(Result.Error e)
                                  '(Result.Success rows)
                                  (list 'if
                                        '(= (Array.length &rows) 0)
                                        '(Result.Error @"no rows returned")
                                        (list 'let-do
                                              [(Symbol.from "c0")
                                               '(copy
                                                 (Array.unsafe-nth (Array.unsafe-nth &rows
                                                                                     0)
                                                                   0))]
                                              (list 'Result.Success
                                                    (list '/=
                                                          (ORM.extract-for backend
                                                                           'Int
                                                                           (Symbol.from "c0"))
                                                          0)))))))

                (list 'doc
                      'find-ordered
                      "returns all rows sorted by the given ORDER BY clause.

`order-by` is a SQL fragment (e.g. `\"text ASC\"` or
`\"id DESC, text ASC\"`).")
                (list 'defn
                      'find-ordered
                      ['db 'order-by]
                      (list 'let
                            ['sql
                             (list 'String.append
                                   (String.concat [select-all-sql " ORDER BY "])
                                   'order-by)]
                            (list 'match
                                  (list query-sym 'db '&sql '&[])
                                  '(Result.Error e)
                                  '(Result.Error e)
                                  '(Result.Success rows)
                                  (list 'Result.Success
                                        (list 'Array.copy-map
                                              (list 'ref
                                                    (list 'fn
                                                          ['cols]
                                                          (list 'let-do
                                                                (ORM.row-let-bindings all-mems
                                                                                      'cols)
                                                                (ORM.init-call-from-cols backend
                                                                                         name
                                                                                         all-mems))))
                                              '&rows)))))

                (list 'doc
                      'find-where-ordered
                      "returns rows matching a SQL WHERE clause, sorted by the
given ORDER BY clause.

`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`),
`params` is a ref to an array of bound parameters, and
`order-by` is a SQL fragment (e.g. `\"text ASC\"`).")
                (list 'defn
                      'find-where-ordered
                      ['db 'where-clause 'params 'order-by]
                      (list 'let
                            ['base
                             (list 'String.append
                                   select-where-prefix
                                   'where-clause)
                             's1
                             (list 'String.append '&base " ORDER BY ")
                             'sql
                             (list 'String.append '&s1 'order-by)]
                            (list 'match
                                  (list query-sym 'db '&sql 'params)
                                  '(Result.Error e)
                                  '(Result.Error e)
                                  '(Result.Success rows)
                                  (list 'Result.Success
                                        (list 'Array.copy-map
                                              (list 'ref
                                                    (list 'fn
                                                          ['cols]
                                                          (list 'let-do
                                                                (ORM.row-let-bindings all-mems
                                                                                      'cols)
                                                                (ORM.init-call-from-cols backend
                                                                                         name
                                                                                         all-mems))))
                                              '&rows)))))

                (list 'doc
                      'find-page
                      "returns a page of rows sorted by the given ORDER BY
clause.

`order-by` is a SQL fragment (e.g. `\"id ASC\"`), `limit` is the
maximum number of rows to return, and `offset` is the number of
rows to skip.")
                (list 'defn
                      'find-page
                      ['db 'order-by 'limit 'offset]
                      (list 'let
                            ['lim-s
                             (list 'Int.str 'limit)
                             'off-s
                             (list 'Int.str 'offset)
                             'sql
                             (list 'str*
                                   (String.concat [select-all-sql " ORDER BY "])
                                   'order-by
                                   " LIMIT "
                                   '&lim-s
                                   " OFFSET "
                                   '&off-s)]
                            (list 'match
                                  (list query-sym 'db '&sql '&[])
                                  '(Result.Error e)
                                  '(Result.Error e)
                                  '(Result.Success rows)
                                  (list 'Result.Success
                                        (list 'Array.copy-map
                                              (list 'ref
                                                    (list 'fn
                                                          ['cols]
                                                          (list 'let-do
                                                                (ORM.row-let-bindings all-mems
                                                                                      'cols)
                                                                (ORM.init-call-from-cols backend
                                                                                         name
                                                                                         all-mems))))
                                              '&rows)))))

                (list 'doc
                      'find-where-page
                      "returns a page of rows matching a SQL WHERE clause,
sorted by the given ORDER BY clause.

`where-clause` is a SQL fragment (e.g. `\"done = ?1\"`),
`params` is a ref to an array of bound parameters,
`order-by` is a SQL fragment (e.g. `\"id ASC\"`), `limit` is the
maximum number of rows to return, and `offset` is the number of
rows to skip.")
                (list 'defn
                      'find-where-page
                      ['db 'where-clause 'params 'order-by 'limit 'offset]
                      (list 'let
                            ['base
                             (list 'String.append
                                   select-where-prefix
                                   'where-clause)
                             'lim-s
                             (list 'Int.str 'limit)
                             'off-s
                             (list 'Int.str 'offset)
                             'sql
                             (list 'str*
                                   '&base
                                   " ORDER BY "
                                   'order-by
                                   " LIMIT "
                                   '&lim-s
                                   " OFFSET "
                                   '&off-s)]
                            (list 'match
                                  (list query-sym 'db '&sql 'params)
                                  '(Result.Error e)
                                  '(Result.Error e)
                                  '(Result.Success rows)
                                  (list 'Result.Success
                                        (list 'Array.copy-map
                                              (list 'ref
                                                    (list 'fn
                                                          ['cols]
                                                          (list 'let-do
                                                                (ORM.row-let-bindings all-mems
                                                                                      'cols)
                                                                (ORM.init-call-from-cols backend
                                                                                         name
                                                                                         all-mems))))
                                              '&rows)))))))))

(defmodule ORM
  (hidden txn-stmt-form)
  (defndynamic txn-stmt-form [backend sql-name db-sym]
    (let [query-sym (ORM.backend-call backend 'query-fn (list))
          sql (ORM.backend-call backend sql-name (list))]
      (list 'match
            (list query-sym db-sym sql '&[])
            '(Result.Success _)
            '(Result.Success ())
            '(Result.Error e)
            '(Result.Error e))))

  (doc begin "begins a database transaction.

`backend` is the backend module and `db` is a reference to the database
connection. Returns `(Result () String)`.

```
(ORM.begin SQLiteBackend &db)
```")
  (defmacro begin [backend db] (ORM.txn-stmt-form backend 'begin-sql db))

  (doc commit "commits the current transaction.

Returns `(Result () String)`.

```
(ORM.commit SQLiteBackend &db)
```")
  (defmacro commit [backend db] (ORM.txn-stmt-form backend 'commit-sql db))

  (doc rollback "rolls back the current transaction.

Returns `(Result () String)`.

```
(ORM.rollback SQLiteBackend &db)
```")
  (defmacro rollback [backend db] (ORM.txn-stmt-form backend 'rollback-sql db))

  (doc with-transaction "runs `body` inside a transaction with auto-rollback.

`body` must evaluate to `(Result a String)`. If it returns `Success`,
the transaction is committed and the value is returned. If it returns
`Error`, the transaction is rolled back and the error is propagated.
If the commit itself fails, the transaction is also rolled back.

```
(ORM.with-transaction SQLiteBackend &db
  (do
    (ignore (Item.insert &db &item1))
    (Item.insert &db &item2)))
```")
  (defmacro with-transaction [backend db body]
    (let [query-sym (ORM.backend-call backend 'query-fn (list))
          begin-sql (ORM.backend-call backend 'begin-sql (list))
          commit-sql (ORM.backend-call backend 'commit-sql (list))
          rollback-sql (ORM.backend-call backend 'rollback-sql (list))]
      (list 'match
            (list query-sym db begin-sql '&[])
            '(Result.Error e)
            '(Result.Error e)
            '(Result.Success _)
            (list 'let
                  ['txn-res body]
                  (list 'match
                        'txn-res
                        '(Result.Error e)
                        (list 'do
                              (list 'ignore
                                    (list query-sym db rollback-sql '&[]))
                              '(Result.Error e))
                        '(Result.Success v)
                        (list 'match
                              (list query-sym db commit-sql '&[])
                              '(Result.Error e)
                              (list 'do
                                    (list 'ignore
                                          (list query-sym db rollback-sql '&[]))
                                    '(Result.Error e))
                              '(Result.Success _)
                              '(Result.Success v))))))))
