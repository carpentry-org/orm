(load "../orm.carp")
(load "git@github.com:carpentry-org/sqlite3@0.2.0")

(doc SQLiteBackend "is the SQLite backend for the ORM.

Loading this file pulls in the ORM core and the `carpentry-org/sqlite3`
package, then registers the dynamic helpers that `derive-model` uses to
emit SQL and row marshalling.

```
(load \"git@github.com:carpentry-org/orm@0.4.0\" \"backends/sqlite3.carp\")

(deftype Item [id Int text String done Bool])
(derive-model Item SQLiteBackend [id Int])
```

Generated functions take an `&SQLite3.SQLite` as their first argument.
Supported field types are `Int`, `Long`, `Double`, `Float`, `String`, and
`Bool`. Anything else raises a macro error at expansion time.
")

(defmodule SQLiteBackend
  ; Map a Carp type symbol to a SQLite storage class.
  (hidden sql-type)
  (defndynamic sql-type [t]
    (cond
      (= t 'Int) "INTEGER"
      (= t 'Long) "INTEGER"
      (= t 'Bool) "INTEGER"
      (= t 'Double) "REAL"
      (= t 'Float) "REAL"
      (= t 'String) "TEXT"
      (macro-error (String.concat ["SQLiteBackend: unsupported type " (str t)]))))

  ; SQLite parameter placeholders are 1-indexed, `?1 ?2 ...`.
  (hidden placeholder)
  (defndynamic placeholder [n] (String.concat ["?" (str n)]))

  ; The static function the generated code calls to run a query.
  (hidden query-fn)
  (defndynamic query-fn [] 'SQLite3.query)

  ; SQL snippet that returns the most recent auto-assigned rowid.
  (hidden last-insert-id-sql)
  (defndynamic last-insert-id-sql [] "SELECT last_insert_rowid()")

  ; Given a Carp type and a variable holding an owned SQLite3.Type value,
  ; return a form extracting the underlying Carp value.
  (hidden extract-col)
  (defndynamic extract-col [t col-var]
    (cond
      (= t 'Int)
        (list 'Long.to-int
              (list 'match col-var '(SQLite3.Type.Integer v) 'v '_ '0l))
      (= t 'Long) (list 'match col-var '(SQLite3.Type.Integer v) 'v '_ '0l)
      (= t 'Double) (list 'match col-var '(SQLite3.Type.Floating v) 'v '_ '0.0)
      (= t 'Float)
        (list 'Double.to-float
              (list 'match col-var '(SQLite3.Type.Floating v) 'v '_ '0.0))
      (= t 'String) (list 'match col-var '(SQLite3.Type.Text v) 'v '_ '@"")
      (= t 'Bool)
        (list 'match col-var '(SQLite3.Type.Integer v) '(/= v 0l) '_ 'false)
      (macro-error (String.concat ["SQLiteBackend: unsupported type " (str t)]))))

  ; Given a Carp type and an expression producing a reference to the value,
  ; return a form that converts it into a bound parameter.
  (hidden bind-value)
  (defndynamic bind-value [t expr] (list 'to-sqlite3 (list 'copy expr)))

  ; SQL statements for transaction control.
  (hidden begin-sql)
  (defndynamic begin-sql [] "BEGIN TRANSACTION")

  (hidden commit-sql)
  (defndynamic commit-sql [] "COMMIT")

  (hidden rollback-sql)
  (defndynamic rollback-sql [] "ROLLBACK"))
